{
	"name": "@ever/long-tasks",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json && shx mkdir -p dist/migrations && shx cp src/migrations/*.sql dist/migrations/",
		"test": "vitest --run"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"croner": "10.0.1",
		"typebox": "1.3.7"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
